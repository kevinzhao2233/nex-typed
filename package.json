{
  "name": "nex-typed",
  "type": "module",
  "version": "0.1.0",
  "description": "A modern TypeScript typing animation library for the browser. Create terminal-style typing effects with full control over animation, cursor behavior, and callbacks.",
  "author": "KevinZhao kevin_2233@qq.com",
  "license": "MIT",
  "homepage": "https://github.com/kevinzhao2233/nex-typed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinzhao2233/nex-typed.git"
  },
  "bugs": {
    "url": "https://github.com/kevinzhao2233/nex-typed/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "keywords": [
    "typed",
    "typing",
    "animation",
    "typewriter",
    "terminal",
    "typescript",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run test -- --run && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/node": "^25.0.10",
    "bumpp": "^11.1.0",
    "jsdom": "^29.1.1",
    "tsdown": "^0.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
